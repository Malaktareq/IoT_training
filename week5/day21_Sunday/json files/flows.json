    {
        "id": "df0c9641848af36a",
        "type": "function",
        "z": "c7cfcb1d5513be71",
        "name": "function 4",
        "func": "// Retrieve current cached state or initialize default structure\nlet state = flow.get('current_state') || {\n    temperature: 0,\n    humidity: 0,\n    pressure: 0,\n    motor_running: false,\n    direction: \"STOP\",\n    speed: 0,\n    timestamp: 0\n};\n\nlet topic = (msg.topic || \"\").toLowerCase();\nlet val = msg.payload;\n\n// Map topic to state\nif (topic.includes(\"temp\")) {\n    let num = Number(val);\n    if (!isNaN(num)) state.temperature = Number(num.toFixed(2));\n} else if (topic.includes(\"humid\")) {\n    let num = Number(val);\n    if (!isNaN(num)) state.humidity = Number(num.toFixed(2));\n} else if (topic.includes(\"press\")) {\n    let num = Number(val);\n    if (!isNaN(num)) state.pressure = Number(num.toFixed(2));\n} else if (topic.includes(\"power\")) {\n    state.motor_running = val;\n} else if (topic.includes(\"direction\")) {\n    state.direction = String(val);\n} else if (topic.includes(\"speed\")) {\n    let num = Number(val);\n    if (!isNaN(num)) state.speed = num;\n}\n\n// Update timestamp\nstate.timestamp = Date.now();\n\n// Save state back to flow context\nflow.set('current_state', state);\n\n// Send updated snapshot to Firebase\nmsg.payload = state;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 700,
        "y": 360,
